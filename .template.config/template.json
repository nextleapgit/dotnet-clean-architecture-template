{
  "$schema": "http://json.schemastore.org/template",
  "author": "AbdulnaserRamadan",
  "classifications": [
    "Web",
    "API",
    "Clean Architecture",
    "Multi-tenant"
  ],
  "identity": "CleanArchitecture.Template.Api",
  "name": "Clean Architecture API (multi-tenant, .NET 10)",
  "description": "Layered Clean Architecture Web API: CQRS dispatchers, EF Core stores, tenancy, permissions, audit, transactional email outbox, Scalar, OpenTelemetry, and a full test suite.",
  "shortName": "ca-api",
  "sourceName": "CleanArchitecture",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "guids": [
    "7af30323-108a-4923-bd46-e13b7648968c",
    "34bb3069-d5d0-4046-acad-a2025ed7678f"
  ],
  "forms": {
    "kebab": {
      "identifier": "kebabCase"
    }
  },
  "symbols": {
    "kebabName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "kebab",
      "replaces": "clean-architecture"
    }
  },
  "sources": [
    {
      "include": [
        "src/**/*.cs",
        "src/**/*.csproj",
        "src/**/appsettings.json",
        "src/**/appsettings.Development.json",
        "src/**/launchSettings.json",
        "src/**/*.http",
        "src/**/Dockerfile",
        "tests/**/*.cs",
        "tests/**/*.csproj",
        ".claude/**/*.md",
        ".github/workflows/*.yml",
        ".github/dependabot.yml",
        "docs/architecture.md",
        "docs/security.md",
        "docs/email-outbox.md",
        "docs/template.md",
        "docs/security-hardening.md",
        "scripts/*.ps1",
        "*.slnx",
        "Directory.Build.props",
        "Directory.Packages.props",
        "global.json",
        "dotnet-tools.json",
        "launchSettings.json",
        "docker-compose.yml",
        "docker-compose.override.yml",
        "docker-compose.dcproj",
        ".editorconfig",
        ".gitattributes",
        ".gitignore",
        ".dockerignore",
        "README.md",
        "CLAUDE.md"
      ],
      "modifiers": [
        {
          "exclude": [
            ".git/**",
            ".vs/**",
            ".containers/**",
            "obj/**",
            "**/bin/**",
            "**/obj/**",
            "**/TestResults/**",
            "**/*.user",
            ".template.config/**",
            "template-pack/**",
            "scripts/init-project.ps1",
            "scripts/test-template-package.ps1",
            ".github/workflows/release.yml",
            "TestResults/**",
            "bin/**",
            "artifacts/**",
            ".github/workflows/template.yml"
          ]
        }
      ]
    }
  ]
}
