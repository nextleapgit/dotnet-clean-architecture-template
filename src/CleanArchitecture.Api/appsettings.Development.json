{
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=clean-architecture;Username=postgres;Password=postgres;Include Error Detail=true"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "ServerUrl": "http://localhost:5341"
        }
      }
    ]
  },
  "Jwt": {
    "Secret": "super-duper-secret-value-that-should-be-in-user-secrets",
    "Issuer": "clean-architecture",
    "Audience": "developers",
    "ExpirationInMinutes": 60
  },
  "EmailOutbox": {
    "Enabled": true
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "SecurityMode": "None",
    "SenderAddress": "no-reply@cleanarchitecture.local",
    "SenderName": "Clean Architecture"
  }
}