<Project Sdk="Microsoft.NET.Sdk">

  <!-- Packs the repository as a `dotnet new` template (short name: ca-api). Not part of the solution. -->
  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>CleanArchitecture.Template</PackageId>
    <PackageVersion>3.1.1</PackageVersion>
    <Title>Clean Architecture API template</Title>
    <Authors>AbdulnaserRamadan</Authors>
    <Description>Layered, multi-tenant Clean Architecture Web API for .NET 10.</Description>
    <PackageTags>dotnet-new;templates;clean-architecture</PackageTags>

    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <EnableDefaultItems>false</EnableDefaultItems>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- NU5110/NU5111: the .ps1 files are template content, not NuGet install scripts. -->
    <NoWarn>$(NoWarn);NU5128;NU5110;NU5111</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\src\**\*.cs;..\src\**\*.csproj;..\src\**\appsettings.json;..\src\**\appsettings.Development.json;..\src\**\launchSettings.json;..\src\**\*.http"
             Exclude="..\src\**\bin\**;..\src\**\obj\**;..\src\**\.containers\**"
             PackagePath="content\src\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- NuGet treats a PackagePath without an extension as a folder, so an extensionless file such as a
         Dockerfile takes its folder as the PackagePath; otherwise it lands at Dockerfile/Dockerfile.
         The trailing separator must be "/": on Linux a trailing "\" is not a separator. -->
    <Content Include="..\src\CleanArchitecture.Api\Dockerfile" PackagePath="content/src/CleanArchitecture.Api/" />
    <Content Include="..\tests\**\*.cs;..\tests\**\*.csproj"
             Exclude="..\tests\**\bin\**;..\tests\**\obj\**"
             PackagePath="content\tests\%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="..\.claude\**\*.md" PackagePath="content\.claude\%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="..\.github\**\*.yml" PackagePath="content\.github\%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="..\.template.config\template.json" PackagePath="content\.template.config\template.json" />
    <Content Include="..\docs\architecture.md;..\docs\security.md;..\docs\email-outbox.md;..\docs\template.md;..\docs\security-hardening.md"
             PackagePath="content\docs\%(Filename)%(Extension)" />
    <Content Include="..\scripts\*.ps1" PackagePath="content\scripts\%(Filename)%(Extension)" />
    <Content Include="..\CleanArchitecture.slnx;..\Directory.Build.props;..\Directory.Packages.props;..\global.json;..\dotnet-tools.json;..\launchSettings.json;..\docker-compose.yml;..\docker-compose.override.yml;..\docker-compose.dcproj;..\.editorconfig;..\.gitattributes;..\.gitignore;..\.dockerignore;..\README.md;..\CLAUDE.md"
             PackagePath="content\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
