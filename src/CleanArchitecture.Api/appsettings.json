{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "",
    "Audience": "",
    "ExpirationInMinutes": 0
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 100,
      "WindowInSeconds": 60
    },
    "Authentication": {
      "PermitLimit": 10,
      "WindowInSeconds": 60
    }
  },
  "EmailOutbox": {
    "Enabled": false,
    "PollIntervalSeconds": 5,
    "MaxAttempts": 8,
    "LeaseSeconds": 120,
    "CompletionTimeoutSeconds": 10,
    "RetryBaseDelaySeconds": 30,
    "RetryMaxDelaySeconds": 3600,
    "SettlementBatchSize": 100,
    "CleanupBatchSize": 500,
    "RetentionDays": 14,
    "CleanupIntervalMinutes": 60,
    "HealthBacklogThresholdSeconds": 600
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "SecurityMode": "StartTls",
    "SenderAddress": "",
    "SenderName": "",
    "TimeoutSeconds": 30
  }
}